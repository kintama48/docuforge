{
  "name": "DocuForgeRenderImage",
  "method": "POST",
  "url": "{{docuforgeBaseUrl}}/v1/render/image",
  "headers": {
    "X-API-Key": "{{docuforgeApiKey}}",
    "Content-Type": "application/json"
  },
  "body": {
    "template_id": "{{templateId}}",
    "format": "{{format}}",
    "dpi": "{{dpi}}",
    "quality": "{{quality}}",
    "page_numbers": "{{pageNumbers}}",
    "data": "{{payloadData}}"
  },
  "responseType": "bytes"
}
