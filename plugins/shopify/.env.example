# Shopify App Credentials (from Shopify Partners Dashboard)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app-url.ngrok.io
SCOPES=read_orders,read_products,read_customers

# Database
DATABASE_URL=file:./dev.db

# Encryption key for storing API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Internal API secret for Flow action communication
INTERNAL_API_SECRET=your_internal_secret

# Optional
PORT=3000
NODE_ENV=development
