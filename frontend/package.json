{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build --webpack",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "test:coverage:safe": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage --no-threads",
    "test:e2e": "playwright test",
    "test:load": "bun test ../load-test/tests",
    "bench:load:smoke": "bash ../load-test/scripts/run-k6-benchmark.sh smoke",
    "bench:load": "bash ../load-test/scripts/run-k6-benchmark.sh baseline",
    "bench:load:stress": "bash ../load-test/scripts/run-k6-benchmark.sh stress",
    "bench:competitors:legacy": "bun run scripts/benchmarks/run-competitor-benchmarks.ts",
    "bench:competitors:legacy:strict": "BENCH_REQUIRE_ALL_TOOLS=1 bun run scripts/benchmarks/run-competitor-benchmarks.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.42.0",
    "@tanstack/react-query": "^5.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "monaco-editor": "^0.52.0",
    "next": "^16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.0",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^25.0.1",
    "msw": "2.7.0",
    "puppeteer": "^24.37.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "wrangler": "^4.65.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "puppeteer",
    "sharp",
    "unrs-resolver"
  ]
}
