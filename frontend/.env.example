# Frontend environment template
NEXT_PUBLIC_API_URL=https://api.example.com

# Billing switches
# NEXT_PUBLIC_BILLING_ENABLED: true|false
# NEXT_PUBLIC_BILLING_PROVIDER: none|paddle|lemonsqueezy
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_PROVIDER=none
NEXT_PUBLIC_BILLING_PORTAL_URL=

# App URLs
NEXT_PUBLIC_APP_NAME=DocuForge
NEXT_PUBLIC_APP_URL=https://console.example.com
NEXT_PUBLIC_MARKETING_URL=https://www.example.com
NEXT_PUBLIC_CONSOLE_URL=https://console.example.com

# Observability (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Legacy compatibility fallbacks (optional)
# VITE_API_URL=https://api.example.com
# VITE_APP_NAME=DocuForge
# VITE_APP_URL=https://console.example.com
