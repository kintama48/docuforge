# Server
PORT=3000
NODE_ENV=production
# Console base URL (CORS + OAuth redirects)
APP_URL=https://console.docuforge.app
API_URL=https://api.docuforge.app

# Database
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-token

# Rust Engine
ENGINE_URL=http://127.0.0.1:3001
ENGINE_TIMEOUT_MS=5000

# Cloudflare R2
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-key
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET=docuforge-assets
R2_PUBLIC_URL=https://assets.docuforge.app

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEV_PRICE_ID=price_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# AI
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.5-flash

# Sentry (optional)
# SENTRY_DSN=https://key@sentry.io/project
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Auth
JWT_SECRET=your-256-bit-secret-change-this-in-production
JWT_EXPIRY=7d

# Redis
REDIS_URL=rediss://your-managed-redis-host:6379

# OAuth
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-client-id
OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Limits defaults are centralized in api/src/config/config.ts.
# Set overrides here only when production needs non-default quotas.

# Resend Email Service
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@docuforge.app
EMAIL_FROM_NOREPLY=noreply@docuforge.app
EMAIL_FROM_SUPPORT=support@docuforge.app
EMAIL_FROM_HELLO=hello@docuforge.app
EMAIL_FROM_BILLING=billing@docuforge.app
EMAIL_RESEND_MAX_PER_SECOND=1
EMAIL_RESEND_MAX_PER_MINUTE=30
EMAIL_RESEND_MAX_PER_DAY=90
EMAIL_RESEND_MAX_RETRIES=6
EMAIL_RESEND_RETRY_BASE_MS=750
EMAIL_RESEND_RETRY_MAX_MS=10000
RESEND_API_KEY=re_NoBJrXEY_JRstci3cm7rU7MgtmpsoVjDX
