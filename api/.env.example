# Server
PORT=3000
NODE_ENV=development
# Console base URL (CORS + OAuth redirects)
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database
DATABASE_URL=file:./local.db
# For Turso production:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-token

# Rust Engine
ENGINE_URL=http://127.0.0.1:3001
ENGINE_TIMEOUT_MS=5000

# Redis Render Queue (set enabled=true when Redis is available)
REDIS_URL=redis://127.0.0.1:6379
RENDER_QUEUE_ENABLED=false
RENDER_QUEUE_AUTO_START_WORKER=true
RENDER_QUEUE_NAME=docuforge-render
RENDER_QUEUE_CONCURRENCY=2
RENDER_QUEUE_ATTEMPTS=3
RENDER_QUEUE_BACKOFF_MS=2000
RENDER_QUEUE_RESULT_TTL_SECONDS=3600

# Cloudflare R2
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-key
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET=docuforge-assets
R2_PUBLIC_URL=https://assets.docuforge.app

# Billing
# Set BILLING_ENABLED=false to run in free-only mode (recommended for pre-launch user acquisition)
BILLING_ENABLED=false
# one of: none | paddle | lemonsqueezy
BILLING_PROVIDER=none
# Optional redirect overrides
# BILLING_SUCCESS_URL=http://localhost:5173/settings?upgraded=true
# BILLING_CANCEL_URL=http://localhost:5173/settings

# Paddle (required when BILLING_PROVIDER=paddle and BILLING_ENABLED=true)
# PADDLE_API_KEY=your-paddle-api-key
# PADDLE_API_URL=https://api.paddle.com
# PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
# PADDLE_PRICE_ID_DEV=pri_...
# PADDLE_PRICE_ID_STARTER=pri_...
# PADDLE_PRICE_ID_PRO=pri_...

# Lemon Squeezy (required when BILLING_PROVIDER=lemonsqueezy and BILLING_ENABLED=true)
# LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
# LEMONSQUEEZY_API_URL=https://api.lemonsqueezy.com/v1
# LEMONSQUEEZY_WEBHOOK_SECRET=your-lemonsqueezy-webhook-secret
# LEMONSQUEEZY_STORE_ID=12345
# LEMONSQUEEZY_VARIANT_ID_DEV=99999
# LEMONSQUEEZY_VARIANT_ID_STARTER=12345
# LEMONSQUEEZY_VARIANT_ID_PRO=67890

# AI
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.5-flash

# Sentry (optional)
# SENTRY_DSN=https://key@sentry.io/project
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Auth
JWT_SECRET=your-256-bit-secret-change-this-in-production
JWT_EXPIRY=7d

# OAuth
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-client-id
OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Limits
FREE_MONTHLY_LIMIT=1000
DEV_MONTHLY_LIMIT=3000
STARTER_MONTHLY_LIMIT=10000
PRO_MONTHLY_LIMIT=50000
MAX_UPLOAD_SIZE_MB=10
