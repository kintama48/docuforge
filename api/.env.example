# Server
PORT=3000
NODE_ENV=development
# Console base URL (CORS + OAuth redirects)
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database
DATABASE_URL=file:./local.db
# For Turso production:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-token

# Rust Engine
ENGINE_URL=http://127.0.0.1:3001
ENGINE_TIMEOUT_MS=5000

# Redis Render Queue (set enabled=true when Redis is available)
REDIS_URL=redis://127.0.0.1:6379
RENDER_QUEUE_ENABLED=false
RENDER_QUEUE_AUTO_START_WORKER=true
RENDER_QUEUE_NAME=docuforge-render
RENDER_QUEUE_CONCURRENCY=2
RENDER_QUEUE_ATTEMPTS=3
RENDER_QUEUE_BACKOFF_MS=2000
RENDER_QUEUE_RESULT_TTL_SECONDS=3600

# Cloudflare R2
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-key
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET=docuforge-assets
R2_PUBLIC_URL=https://assets.docuforge.app

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEV_PRICE_ID=price_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# AI
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.5-flash

# Sentry (optional)
# SENTRY_DSN=https://key@sentry.io/project
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Auth
JWT_SECRET=your-256-bit-secret-change-this-in-production
JWT_EXPIRY=7d

# OAuth
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-client-id
OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Limits
FREE_MONTHLY_LIMIT=1000
DEV_MONTHLY_LIMIT=3000
STARTER_MONTHLY_LIMIT=10000
PRO_MONTHLY_LIMIT=50000
MAX_UPLOAD_SIZE_MB=10
