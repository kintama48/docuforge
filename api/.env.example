# Server
PORT=3000
NODE_ENV=development
# Console base URL (CORS + OAuth redirects)
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database
DATABASE_URL=libsql://docuforge-kintama48.aws-us-east-2.turso.io
DATABASE_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3NzM2NDAxNDYsImlkIjoiODhkYWM3NGEtMjAwMS00Yzg0LWE1MmMtNDExNzkxZGEwMjU2IiwicmlkIjoiMWVhNmU0MjEtYmIwZS00NWI2LTk1YzAtMGY1MDFhNTk0YzkwIn0.ztyN8TztKVE3WAh5UFlYsMy038otaVYVEEZqYFUqb6IL0hJRkIs5Ca1slxRuIyHulZphIx-4z8kp4tKavh6gCw

# For Turso production:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-token

# Rust Engine
ENGINE_URL=http://127.0.0.1:3001
ENGINE_TIMEOUT_MS=5000

# Cloudflare R2
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-key
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET=docuforge-assets
R2_PUBLIC_URL=https://assets.docuforge.app

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEV_PRICE_ID=price_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# AI
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.5-flash

# Sentry (optional)
# SENTRY_DSN=https://key@sentry.io/project
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Auth
JWT_SECRET=your-256-bit-secret-change-this-in-production
JWT_EXPIRY=7d
AUTH_EMAIL_VERIFICATION_REQUIRED=true
AUTH_2FA_REQUIRED=true
AUTH_OTP_TTL_MS=600000
AUTH_OTP_RESEND_COOLDOWN_MS=30000
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_SENDS=5
AUTH_MAX_ACCOUNTS_PER_FINGERPRINT=3
AUTH_MAX_SIGNUPS_PER_FINGERPRINT_PER_DAY=3
AUTH_MAX_SIGNUPS_PER_IP_PER_DAY=6
# Session cookie (browser auth)
AUTH_COOKIE_NAME=docuforge_session
AUTH_COOKIE_MAX_AGE_SECONDS=604800
# AUTH_COOKIE_DOMAIN=.docuforge.app
AUTH_COOKIE_SAME_SITE=strict

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Transactional email (verification + 2FA codes)
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@docuforge.app
EMAIL_FROM_NOREPLY=noreply@docuforge.app
EMAIL_FROM_SUPPORT=support@docuforge.app
EMAIL_FROM_HELLO=hello@docuforge.app
EMAIL_FROM_BILLING=billing@docuforge.app
EMAIL_RESEND_MAX_PER_SECOND=1
EMAIL_RESEND_MAX_PER_MINUTE=30
EMAIL_RESEND_MAX_PER_DAY=90
EMAIL_RESEND_MAX_RETRIES=6
EMAIL_RESEND_RETRY_BASE_MS=750
EMAIL_RESEND_RETRY_MAX_MS=10000
# RESEND_API_KEY=re_...

# OAuth
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-client-id
OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Limits defaults are centralized in api/src/config/config.ts.
# Uncomment only when you need environment-specific overrides.
# FREE_MONTHLY_LIMIT=1000
# DEV_MONTHLY_LIMIT=3000
# STARTER_MONTHLY_LIMIT=10000
# PRO_MONTHLY_LIMIT=50000
# FREE_MONTHLY_AI_CREDITS=5
# DEV_MONTHLY_AI_CREDITS=25
# STARTER_MONTHLY_AI_CREDITS=120
# PRO_MONTHLY_AI_CREDITS=600
# MAX_UPLOAD_SIZE_MB=10

# Webhook delivery queue (BullMQ + Redis)
WEBHOOK_QUEUE_ENABLED=true
WEBHOOK_QUEUE_NAME=docuforge-webhook-delivery
WEBHOOK_QUEUE_CONCURRENCY=10
WEBHOOK_QUEUE_ATTEMPTS=3
WEBHOOK_QUEUE_BACKOFF_MS=30000

# Public preview hardening (JWT-free playground renders)
PUBLIC_PREVIEW_SESSION_TTL_SECONDS=1800
PUBLIC_PREVIEW_MAX_RENDERS_PER_SESSION=30
PUBLIC_PREVIEW_MAX_SESSIONS=10000
PUBLIC_PREVIEW_IP_RATE_LIMIT_PER_MINUTE=60
PUBLIC_PREVIEW_SESSION_RATE_LIMIT_PER_MINUTE=12
PUBLIC_PREVIEW_SESSION_CREATE_RATE_LIMIT_PER_MINUTE=20
# Comma-separated allowlist. Defaults to APP_URL origin.
# PUBLIC_PREVIEW_ALLOWED_ORIGINS=https://docuforge.app,https://www.docuforge.app
PUBLIC_PREVIEW_WATERMARK_LABEL=DOCUFORGE PUBLIC PREVIEW · NOT FOR PRODUCTION
