# Compose-level vars used for frontend build args.
# Runtime secrets/config stay in service-level env files:
# - api/.env
# - frontend/.env
# - engine/.env

NEXT_PUBLIC_API_URL=https://api.docuforge.app
NEXT_PUBLIC_APP_NAME=DocuForge
NEXT_PUBLIC_APP_URL=https://www.docuforge.app
NEXT_PUBLIC_MARKETING_URL=https://www.docuforge.app
NEXT_PUBLIC_CONSOLE_URL=https://www.docuforge.app
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_PROVIDER=none
NEXT_PUBLIC_BILLING_PORTAL_URL=
NEXT_PUBLIC_SENTRY_DSN=
