# Server
PORT=3200
HOST=0.0.0.0

# MCP auth (required)
MCP_SERVER_TOKEN=76e8d90e76c28ebdfda617447c6d4457ff9d3e52f187137b785a86ff152f655b

# Upstream DocuForge API
DOCUFORGE_API_BASE_URL=http://localhost:3000
DOCUFORGE_API_KEY=docu_live_xxx

# Optional: enable template discovery tools via JWT auth
# Either provide a static token:
# DOCUFORGE_JWT_TOKEN=eyJ...
# Or provide login credentials to mint/cache token at runtime:
# DOCUFORGE_EMAIL=you@example.com
# DOCUFORGE_PASSWORD=your-password

# Limits and timeouts
REQUEST_TIMEOUT_MS=15000
PDF_INLINE_MAX_BYTES=750000
ARTIFACT_TTL_MS=900000

# Optional security hardening
# Comma-separated list of allowed Origin values for browser clients.
# Non-browser MCP clients usually send no Origin.
ALLOWED_ORIGINS=

LOG_LEVEL=info
